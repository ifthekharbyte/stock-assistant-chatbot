# Groq (OpenAI-compatible Responses API) -- get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
MODEL_NAME=openai/gpt-oss-120b

# Massive Stock Market API — get a free key at https://massive.com/dashboard/signup
MASSIVE_API_KEY=...

# Postgres, used for conversation/feedback logging (see docker-compose.yaml)
POSTGRES_DB=stock_assistant
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
